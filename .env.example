# HTTP port for the support inbox UI
PORT=8080

# Loopback bridge (never expose this port publicly)
# On Coolify/compose this is http://bridge:3100
BRIDGE_URL=http://127.0.0.1:3100

# --- Admin ---------------------------------------------------------------
# Created on first boot if that username does not exist yet. An existing user
# with this username is promoted to admin; their password is never overwritten.
# Agents cannot reset their own password — the admin does it in the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-now
ADMIN_NAME=Administrator
# Maximum team size, admin included. Removed members free their seat.
MAX_TEAM=15

# --- Session security ----------------------------------------------------
# Number of reverse proxies in front of the app (Coolify = 1). Needed so the
# session cookie gets Secure and rate limits see the real client IP.
TRUST_PROXY=1
# Leave unset behind HTTPS. 'false' only for a bare-HTTP LAN box — the session
# cookie is then sniffable. 'true' forces Secure if proxy detection fails.
# FORCE_SECURE_COOKIE=

# Largest attachment an agent can send, in MB (WhatsApp itself balks earlier)
MAX_UPLOAD_MB=16

# --- Backups (npm run backup, e.g. a nightly Coolify scheduled task) ------
BACKUP_DIR=data/backups
BACKUP_KEEP_DAYS=14

# --- Outbound safety limits (see README "Not getting banned") ---
# How long after a customer's last message an agent may still reply.
#
# Meta enforces a 24h service window on the OFFICIAL Business API. This runs as
# a linked device, where WhatsApp enforces no such window — so this value is our
# own ban insurance, not a platform rule. 168 (7 days) lets agents finish real
# conversations; the "they must message first" rule below is the half that
# actually matters, and it stays on at any setting.
WINDOW_HOURS=168
# Max outbound messages per chat per hour
CHAT_HOURLY_CAP=15
# Max outbound messages across all chats per hour
GLOBAL_HOURLY_CAP=120
# Identical text to this many distinct chats in 24h = blocked as a broadcast
DUPLICATE_CHAT_LIMIT=3
# ...but only for messages longer than this. Short replies ("ok", "noted",
# "will check") repeat across conversations all day in real support work and
# are not broadcasts. Raise it if agents send longer stock phrases; lower it
# to catch short repeated promos, at the cost of blocking acknowledgements.
DUPLICATE_MIN_LEN=25
# Pacing between sends (ms) — randomised in this range
SEND_GAP_MIN_MS=3000
SEND_GAP_MAX_MS=8000

